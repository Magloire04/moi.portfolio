# En-têtes de sécurité HTTP du site statique, ajoutés par Apache à chaque réponse.
#
# - HSTS : le navigateur n'ouvre plus le site qu'en HTTPS pendant un an. Sans
#   includeSubDomains ni preload, volontairement : ces options engageraient tous
#   les sous-domaines de bytechnum.com, y compris ceux d'autres projets.
# - nosniff : le navigateur respecte le type de contenu annoncé.
# - SAMEORIGIN : seules les pages du site peuvent l'afficher dans un cadre.
# - Referrer-Policy : seul le domaine d'origine est transmis aux sites externes.
#
# Pas de Content-Security-Policy ici : l'export statique de Next.js injecte des
# scripts en ligne, une politique stricte demande d'abord un essai en mode
# rapport (Content-Security-Policy-Report-Only).
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
